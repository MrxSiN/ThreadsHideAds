# PROG_DETECT: is one feed model object an advertisement?
#
# Port of v1.2.1 ReflectiveAdDetector.inspect. Each request inspects one
# object; children are inspected by CALLing this program again one level
# deeper, so the recursion depth is the runtime level depth (bounded by
# DETECT_MAX_DEPTH). The host only reads objects: every decision is here.
#
# OP_DETECT       payload h[4], depth, budget[2] -> found, budget[2]
# OP_CLASS_FACTS  payload h[4]                    -> facts
#
# Class facts, packed LSB first and memoized per class by the host:
#   bit 0 known, bit 1 app model class, bit 2 strong ad class token,
#   bit 3 Pando tree (TreeJNI subclass with a JSON accessor),
#   bit 4 structured toString (app model class overriding toString).

include "lib.bfa"

var h[4], depth, budget[2], found, facts
var go, flag, fresh, d1, strong, value
var i[4], limit[4], looping, fi[2]

# isAdFieldValue for the child descriptor.
macro ad_field_value(v) {
  clear v
  if c_h {
    if c_boolean {
      if c_value { set v 1 }
    } else {
      if c_number {
        if c_value { set v 1 }
      } else {
        if c_charseq {
          var stop
          text MT_STOP_VALUE, c_h, SRC_STRING, TX_LOWER_ROOT, stop
          ifz stop { set v 1 }
        } else {
          if c_enum {
            text MT_STRUCTURED_VALUE, c_h, SRC_ENUM_NAME, TX_LOWER_ROOT, v
          } else {
            set v 1
          }
        }
      }
    }
  }
}

macro find_accessor_native(target, hit) {
  request CAP_FIND_ACCESSOR, 17
  out target
  outc 12
  outs "asJSONNative"
  read_reply r_status
  in hit
}

macro find_accessor_plain(target, hit) {
  request CAP_FIND_ACCESSOR, 11
  out target
  outc 6
  outs "asJSON"
  read_reply r_status
  in hit
}

# compute_facts(target, out_facts): memoized per runtime class.
macro compute_facts(target, out_facts) {
  memo_get target, SLOT_FACTS, zero16, out_facts
  ifz out_facts {
    var app, token, tree, accessor, overrides, pando, structured, one
    var k, super[4], first[4], walking, hit
    text MT_APP_MODEL, target, SRC_CLASS_NAME, TX_RAW, app
    text MT_CLASS_TOKEN, target, SRC_CLASS_NAME, TX_LOWER_ROOT, token
    # PandoTrees.isPandoTreeClass: the class or any superclass is TreeJNI.
    set walking 1
    while walking {
      request CAP_SUPERCLASS, 5
      out target
      out k
      read_reply r_status
      in super
      ifz super {
        clear walking
      } else {
        ifz first { copy super -> first }
        text MT_PANDO_TREE_CLASS, super, SRC_TYPE_NAME, TX_RAW, hit
        if hit {
          set tree 1
          clear walking
        }
      }
      inc k
      ifeq k MAX_SUPERCLASS_WALK { clear walking }
    }
    release first
    # PandoTrees.findAccessor: asJSONNative, else asJSON, (boolean, boolean).
    if tree {
      find_accessor_native target, accessor
      ifz accessor { find_accessor_plain target, accessor }
      if accessor { set pando 1 }
    }
    # Reflection.hasStructuredToString.
    if app {
      request CAP_CLASS_INFO, 4
      out target
      read_reply r_status
      in overrides
      if overrides { set structured 1 }
    }
    set one 1
    pack one, app, token, pando, structured -> out_facts
    memo_put target, SLOT_FACTS, zero16, out_facts
    clear k, super, first, hit
  }
}

# Reflection.shouldInspectChild for the child descriptor.
macro should_inspect_child(result) {
  clear result
  if c_h {
    if c_array { set result 1 }
    if c_collection { set result 1 }
    if c_map { set result 1 }
    if c_enum { set result 1 }
    ifz result {
      if c_charseq {
        le c_size, MAX_INSPECTED_TEXT -> result
      } else {
        var child_facts
        copy c_facts -> child_facts
        ifz child_facts { compute_facts c_h, child_facts }
        unpack_facts child_facts
        copy f_app_model -> result
        clear child_facts
      }
    }
  }
}

# Iterates min(n_size, cap) children in `mode` and inspects each one.
macro inspect_children(mode, cap) {
  copy n_size -> limit
  gt limit, cap -> flag
  if flag { set limit cap }
  clear i, flag
  set looping 1
  while looping {
    lt i, limit -> flag
    ifz flag {
      clear looping
    } else {
      child h, i, mode
      ifne r_status ST_OK {
        clear looping
      } else {
        detect c_h, d1, budget, found
        if found { clear looping }
        if c_h { release c_h }
      }
      inc i
    }
  }
}

macro inspect() {
  clear found
  set go 1
  ifz depth { clear_visited SET_DETECT }
  ifz h { clear go }
  if go {
    gt depth, DETECT_MAX_DEPTH -> flag
    if flag { clear go }
  }
  if go {
    # budget[0]++ > MAX_BUDGET
    gt budget, DETECT_MAX_BUDGET -> flag
    inc budget
    if flag { clear go }
  }
  if go {
    node h
    if n_charseq {
      text MT_STRUCTURED_VALUE, h, SRC_STRING, TX_LOWER_ROOT, found
      clear go
    }
  }
  if go {
    if n_enum {
      text MT_STRUCTURED_VALUE, h, SRC_ENUM_NAME, TX_LOWER_ROOT, found
      clear go
    }
  }
  if go {
    if n_number { clear go }
    if n_boolean { clear go }
    if n_character { clear go }
    if n_class { clear go }
  }
  if go {
    visit SET_DETECT, h, fresh
    ifz fresh { clear go }
  }
  if go {
    copy n_facts -> facts
    ifz facts { compute_facts h, facts }
    unpack_facts facts
    if f_strong_token {
      set found 1
      clear go
    }
  }
  if go {
    if f_pando {
      pando_verdict h, found
      if found { clear go }
    }
  }
  if go {
    if f_structured {
      text MT_STRUCTURED_VALUE, h, SRC_STRING, TX_LOWER_ROOT, found
      if found { clear go }
    }
  }
  if go {
    copy depth -> d1
    inc d1
    if n_map {
      # Map entries: a strong key with an ad value, or an ad value.
      copy n_size -> limit
      gt limit, DETECT_MAX_ENTRIES -> flag
      if flag { set limit DETECT_MAX_ENTRIES }
      clear i, flag
      set looping 1
      while looping {
        lt i, limit -> flag
        ifz flag {
          clear looping
        } else {
          child h, i, MODE_MAP_ENTRY
          ifne r_status ST_OK {
            clear looping
          } else {
            text MT_FIELD_NAME, c_key, SRC_STRING, TX_LOWER_ROOT, strong
            if strong {
              ad_field_value value
              if value { set found 1 }
            }
            ifz found { detect c_h, d1, budget, found }
            if found { clear looping }
            if c_key { release c_key } else { if c_h { release c_h } }
          }
          inc i
        }
      }
    } else {
      if n_collection {
        inspect_children MODE_ITER, DETECT_MAX_ENTRIES
      } else {
        if n_array {
          inspect_children MODE_ARRAY, DETECT_MAX_ENTRIES
        } else {
          # Declared instance fields, all of them.
          copy n_size -> limit
          clear i
          set looping 1
          while looping {
            lt i, limit -> flag
            ifz flag {
              clear looping
            } else {
              child h, i, MODE_FIELD
              ifne r_status ST_OK {
                clear looping
              } else {
                if c_h {
                  clear strong
                  ifeq c_field_fact 2 { set strong 1 }
                  ifz c_field_fact {
                    # First sight of this field: classify its name once.
                    var put
                    text MT_FIELD_NAME, c_h, SRC_FIELD_NAME, TX_LOWER_ROOT, strong
                    set put 1
                    if strong { set put 2 }
                    copy i[0] -> fi[0]
                    copy i[1] -> fi[1]
                    memo_put h, SLOT_FIELD, fi, put
                  }
                  if strong {
                    ad_field_value value
                    if value { set found 1 }
                  }
                  ifz found {
                    lt depth, DETECT_MAX_DEPTH -> flag
                    if flag {
                      should_inspect_child value
                      if value { detect c_h, d1, budget, found }
                    }
                    clear flag
                  }
                  if found { clear looping }
                  release c_h
                }
              }
              inc i
            }
          }
        }
      }
    }
  }
}

read_header
ifne rq_major ABI_MAJOR {
  respond ST_BAD_VERSION, 0
} else {
  switch rq_op {
    case OP_DETECT {
      in h, depth, budget
      inspect
      respond ST_OK, 3
      out found
      out budget
    }
    case OP_CLASS_FACTS {
      in h
      compute_facts h, facts
      respond ST_OK, 1
      out facts
    }
    default {
      respond ST_BAD_OPCODE, 0
    }
  }
}
