# PROG_PANDO: the Pando response layer.
#
# Ports v1.2.1 PandoAdSignals.isSponsoredTree, PandoTrees.readJson's flag
# probing and PandoResponseHooks.filterResult. The host serializes trees,
# caches verdicts per tree and rebuilds lists; the decisions are here.
#
# OP_PANDO_VERDICT h[4]                                  -> sponsored
# OP_PANDO_FILTER  h[4], declared object|null, declared interface,
#                  declared accepts ArrayList, declared type h[4]
#                  -> action, result h[4], removed[4]

include "lib.bfa"

var h[4], d_object, d_interface, d_arraylist, h_declared[4]
var sponsored, action, h_out[4], removed[4], flag, facts

# length := JSON length for (target, flags), JSON_NULL when absent. A text
# longer than PANDO_MAX_JSON reads as absent, as PandoTrees.invoke did.
macro json_length(target, flags, length) {
  cap CAP_JSON_LENGTH, target, flags
  read_reply r_status
  in length
  ifne r_status ST_OK { set length JSON_NULL }
  ifne length JSON_NULL {
    gt length, PANDO_MAX_JSON -> flag
    if flag { set length JSON_NULL }
    clear flag
  }
}

macro verdict() {
  clear sponsored
  var memo, flags, length[4], best[4], have, probe, candidate[4], better, transform
  class_facts h, facts
  unpack_facts facts
  if f_pando {
    cap CAP_TREE_VERDICT_GET, h
    read_reply r_status
    in memo
    ifz memo {
      # PandoTrees.readJson: the flag pair remembered for this class, else
      # all four pairs once, keeping the longest (first wins a tie).
      memo_get h, SLOT_PANDO_FLAGS, zero16, memo
      if memo {
        copy memo -> flags
        sub flags 1
        json_length h, flags, length
      } else {
        set length JSON_NULL
        repeat PANDO_FLAG_COMBINATIONS {
          json_length h, probe, candidate
          ifne candidate JSON_NULL {
            set better 1
            if have {
              gt candidate, best -> better
            }
            if better {
              copy candidate -> best
              copy probe -> flags
              set have 1
            }
            clear better
          }
          inc probe
        }
        if have { copy best -> length }
        copy flags -> memo
        inc memo
        memo_put h, SLOT_PANDO_FLAGS, zero16, memo
      }
      # PandoAdSignals.evaluate
      ifne length JSON_NULL {
        gt length, PANDO_MAX_ITEM_JSON -> flag
        # An oversized tree owns more than one item: never sponsored here.
        ifz flag {
          copy flags -> transform
          addv transform, flags
          inc transform
          text MT_STRUCTURED_VALUE, h, SRC_PANDO_JSON, transform, sponsored
        }
        clear flag
      }
      copy sponsored -> memo
      inc memo
      cap CAP_TREE_VERDICT_PUT, h, memo
      read_reply r_status
    } else {
      ifeq memo 2 { set sponsored 1 }
    }
  }
}

# PandoResponseHooks.filterResult
macro filter() {
  var size_ok, first_ok, i[4], walking, kept[4], item, declared_ok
  clear action, removed
  copy h -> h_out
  node h
  if n_list {
    if n_size { set size_ok 1 }
    gt n_size, PANDO_MAX_LIST -> flag
    if flag { clear size_ok }
    clear flag
  }
  if size_ok {
    # Lists of strings or numbers share these accessors: gate on element 0.
    child h, i, MODE_LIST
    if c_h {
      copy c_facts -> facts
      ifz facts { class_facts c_h, facts }
      unpack_facts facts
      copy f_pando -> first_ok
      release c_h
    }
  }
  if first_ok {
    reset_marks h
    set walking 1
    while walking {
      lt i, n_size -> flag
      ifz flag {
        clear walking
      } else {
        child h, i, MODE_LIST
        ifne r_status ST_OK {
          clear walking
        } else {
          clear item
          if c_h { pando_verdict c_h, item }
          if item {
            mark h, i
            inc removed
          } else {
            inc kept
          }
          if c_h { release c_h }
        }
        inc i
      }
    }
    if removed {
      ifz kept {
        # Emptying breaks callers; the owning item is dropped a level up.
        set action PANDO_BLOCKED
        clear removed
      } else {
        if d_object { set declared_ok 1 }
        if d_arraylist { set declared_ok 1 }
        filtered_copy h, h_out
        ifz declared_ok {
          var kept_h[4], copied[4]
          copy h_out -> kept_h
          cap CAP_COPY_OF, kept_h, h_declared, COPY_DECLARED
          read_reply r_status
          in copied
          ifz copied {
            cap CAP_COPY_OF, kept_h, h, COPY_ORIGINAL
            read_reply r_status
            in copied
          }
          copy copied -> h_out
        }
        if h_out {
          set action PANDO_REPLACED
        } else {
          set action PANDO_REPLACE_FAILED
          copy h -> h_out
          clear removed
        }
      }
    }
  }
}

read_header
ifne rq_major ABI_MAJOR {
  respond ST_BAD_VERSION, 0
} else {
  switch rq_op {
    case OP_PANDO_VERDICT {
      in h
      verdict
      respond ST_OK, 1
      out sponsored
    }
    case OP_PANDO_FILTER {
      in h, d_object, d_interface, d_arraylist, h_declared
      filter
      respond ST_OK, 9
      out action, h_out, removed
    }
    default {
      respond ST_BAD_OPCODE, 0
    }
  }
}
