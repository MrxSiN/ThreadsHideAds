[->+>+<<]>>[-<<+>>]< ------------------------------- ~31 >>+<<[>>[-]<<[-]]>>[ >>>>> + <<<<< [-]]<<< @c
[->+>+<<]>>[-<<+>>]< -------------------------------- ~32 >>+<<[>>[-]<<[-]]>>[ >>>>> + <<<<< [-]]<<< @c
    ---------------- ---------------- ---------------- ---------------- ---------------- ---------------- ~96
    # if t1 then step the trie machine
    >>>>>>>>>>>>>> ~14                        @t1
    [- >> + > + <<< ]                         @t1
    >>>                                       @q
    [- <<< + >>> ]                            @q
    < [                                       @p
      # T1 STEP
      # == trie machine for UNIT TYPE and STRUCTURED VALUE and STOP VALUE
      # States: 0 dead; 1 LEAD (leading trim and the trie root); 2 to 202
      # trie nodes; 203 LEAD after C0; 204 TAIL (trailing trim); 205 TAIL
      # after C0; C0 then 80 is U 0000 which trims like a byte up to 32
      # wt is the class of the last complete word: 1 unit type; 2 other
      # structured word; 3 stop word; it survives trailing trim
      <                                                               @ts
      [- <<<<<<<<<<<<<<<<<<< ~19 + >>>>>>>>>>>>>>>>>>> ~19 ]          @ts
      # q is 1 for a letter: not lo and neither C0 nor 80
      >> +                                                            @q
      <<<<<<<<< ~9                                                    @lo
      [- >>>>> + <<<<<<<<<<<<<<<<<<<<<< ~22 + >>>>>>>>>>>>>>>>> ~17 ]  @lo
      <<<<<<<<<<<<<<<<< ~17                                           @g
      [- >>>>>>>>>>>>>>>>> ~17 + <<<<<<<<<<<<<<<<< ~17 ]              @g
      >>>>>>>>>>>>>>>>>>>>>> ~22                                      @y
      [ >>>> [-] <<<< [-] ]                                           @y
      <<<<<<<<<<<<< ~13                                               @c
      [->+>+<<]>>[-<<+>>]< ---------- ---------- ---------- ---------- ---------- ---------- ---------- ---------- ---------- ------ ~96 >>+<<[>>[-]<<[-]]>>[ >>>>>>>>>>>>>> ~14 [-] <<<<<<<<<<<<<< ~14 [-]]<<< @c
      [->+>+<<]>>[-<<+>>]< ---------- ---------- ---------- -- ~32 >>+<<[>>[-]<<[-]]>>[ >>>>>>>>>>>>>> ~14 [-] <<<<<<<<<<<<<< ~14 [-]]<<< @c
      >>>>>>>>>>>>>>>>> ~17                                           @q
      [ <<<<<<<< [-] >>>>>>>> [-] ]                                   @q
      # after a complete word or in TAIL: trim goes to TAIL and C0 to 205
      <<<<<<<<                                                        @wt
      [- >>>> + <<<<<<<<<<<<<<<<<<<<<< ~22 + >>>>>>>>>>>>>>>>>> ~18 ]  @wt
      <<<<<<<<<<<<<<<<<< ~18                                          @g
      [- >>>>>>>>>>>>>>>>>> ~18 + <<<<<<<<<<<<<<<<<< ~18 ]            @g
      >>>>>>>>>>>>>>>>>>>>>> ~22                                      @y
      [ <<<<<                                                         @lo
        [- >>>>>>>>> ~9 + <<<<<<<<<<<<<<<<<<<<<<<<<< ~26 + >>>>>>>>>>>>>>>>> ~17 ] @lo
        <<<<<<<<<<<<<<<<< ~17                                         @g
        [- >>>>>>>>>>>>>>>>> ~17 + <<<<<<<<<<<<<<<<< ~17 ]            @g
        >>>>>>>>>>>>>>>>>>>>>>>>>> ~26                                @q
        [ <<<<<<<<<<<<< ~13 [-] ---------- ---------- ---------- ---------- ---------- -- ~52 >>>>>>>>>>>>> ~13 [-] ] @q
        <<<<<<<<<<<<<<<<< ~17                                         @c
        [->+>+<<]>>[-<<+>>]< ---------- ---------- ---------- ---------- ---------- ---------- ---------- ---------- ---------- ------ ~96 >>+<<[>>[-]<<[-]]>>[ >[-] ---------- ---------- ---------- ---------- ---------- - ~51 < [-]]<<< @c
        >>>>>>>>>>>>> ~13                                             @y
      [-] ]                                                           @y
      <<<<<<<<<<<<<<<<< ~17                                           @s
      # LEAD: trim stays; C0 to 203; letters start words
      [->+>+<<]>>[-<<+>>]< - ~1 >>+<<[>>[-]<<[-]]>>[                  @eB
        >>>>>>>>> ~9                                                  @lo
        [- >>>>>>>>> ~9 + <<<<<<<<<<<<<<<<<<<<<<<<<< ~26 + >>>>>>>>>>>>>>>>> ~17 ] @lo
