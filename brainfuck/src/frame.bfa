# Request/response framing shared by every program (docs/BRAINFUCK_ABI.md).
#
# Request:  major, minor, opcode, flags, len lo, len hi, id lo, id hi, payload
# Response: major, minor, opcode | 0x80, status, len lo, len hi, id lo, id hi, payload

include "constants.bfa"

var rq_major, rq_minor, rq_op, rq_flags, rq_len[2], rq_id[2]

macro read_header() {
  in rq_major, rq_minor, rq_op, rq_flags, rq_len, rq_id
}

# Writes a response header echoing the request id. `len` is a constant.
macro respond(status, len) {
  var op
  outc ABI_MAJOR
  outc ABI_MINOR
  copy rq_op -> op
  add op RESPONSE_BIT
  out op
  outc status
  outc16 len
  out rq_id
}

# Writes a capability request header. The id is not used by capabilities.
macro request(op, len) {
  outc ABI_MAJOR
  outc ABI_MINOR
  outc op
  outc 0
  outc16 len
  outc16 0
}

# Reads a capability response header; status := header status byte.
macro read_reply(status) {
  var skip
  in skip
  in skip
  in skip
  in status
  in skip
  in skip
  in skip
  in skip
  clear skip
}
