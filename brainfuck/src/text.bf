[->+>+<<]>>[-<<+>>]< -------------- ~14 >>+<<[>>[-]<<[-]]>>[ >>>>> + <<<<< [-]]<<< @c
[->+>+<<]>>[-<<+>>]< --------------- ~15 >>+<<[>>[-]<<[-]]>>[ >>>>> + <<<<< [-]]<<< @c
[->+>+<<]>>[-<<+>>]< ---------------- ~16 >>+<<[>>[-]<<[-]]>>[ >>>>> + <<<<< [-]]<<< @c
[->+>+<<]>>[-<<+>>]< ----------------- ~17 >>+<<[>>[-]<<[-]]>>[ >>>>> + <<<<< [-]]<<< @c
[->+>+<<]>>[-<<+>>]< ------------------ ~18 >>+<<[>>[-]<<[-]]>>[ >>>>> + <<<<< [-]]<<< @c
