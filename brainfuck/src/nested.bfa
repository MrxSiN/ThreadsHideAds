# PROG_NESTED: lists nested inside a returned feed wrapper.
#
# Port of v1.2.1 NestedCollectionSanitizer. One request visits one value;
# children are visited by CALLing this program one level deeper, bounded by
# NESTED_MAX_DEPTH. A replaced list is written back through the slot it was
# read from (CAP_WRITE_BACK), which the host resolves from the handle.
#
# OP_NESTED_SANITIZE h[4]                          -> removed[4], failures[4]
# OP_NESTED_VISIT    h[4], depth, budget[2], has replacer,
#                    slot object|null, slot interface, slot accepts ArrayList
#                    -> removed[4], failures[4], budget[2]

include "lib.bfa"

var h[4], depth, budget[2], has_replacer, s_object, s_interface, s_arraylist
var removed[4], failures[4], go, flag, fresh, d1

# visit_child(depth): NESTED_VISIT of the current child descriptor, adding
# its counts to ours.
macro visit_child() {
  var r[4], f[4]
  request CAP_CALL, 17
  outc PROG_NESTED
  outc OP_NESTED_VISIT
  outc 0
  outc 13
  out c_h
  out d1
  out budget
  outc 1
  out c_decl_object
  out c_decl_interface
  out c_decl_arraylist
  read_reply r_status
  in r, f, budget
  addv removed, r
  addv failures, f
}

# Visits min(n_size, NESTED_MAX_ENTRIES) children of `target` in `mode`.
macro visit_children(target, mode) {
  var i[4], limit[4], walking
  copy n_size -> limit
  gt limit, NESTED_MAX_ENTRIES -> flag
  if flag { set limit NESTED_MAX_ENTRIES }
  clear flag
  set walking 1
  while walking {
    lt i, limit -> flag
    ifz flag {
      clear walking
    } else {
      child target, i, mode
      ifne r_status ST_OK {
        clear walking
      } else {
        if c_h {
          visit_child
          release c_h
        }
      }
      inc i
    }
  }
}

macro visit_value() {
  clear removed, failures
  set go 1
  ifz h { clear go }
  if go {
    gt depth, NESTED_MAX_DEPTH -> flag
    if flag { clear go }
  }
  if go {
    gt budget, NESTED_MAX_BUDGET -> flag
    inc budget
    if flag { clear go }
  }
  if go {
    # Reflection.isSimpleValue
    node h
    if n_charseq { clear go }
    if n_number { clear go }
    if n_boolean { clear go }
    if n_character { clear go }
    if n_enum { clear go }
    if n_class { clear go }
  }
  if go {
    visit SET_NESTED, h, fresh
    ifz fresh { clear go }
  }
  if go {
    copy depth -> d1
    inc d1
    if n_list {
      var changed, h_out[4], count[4], blocked, current[4], diff[4], ok
      request CAP_CALL, 13
      outc PROG_SANITIZE
      outc OP_SANITIZE_LIST
      outc 0
      outc 9
      out h
      out s_object
      out s_interface
      out s_arraylist
      out has_replacer
      outc 0
      read_reply r_status
      in changed, h_out, count, blocked
      copy h -> current
      if changed {
        copy h -> diff
        subv diff, h_out
        ifz diff {
          addv removed, count
        } else {
          if has_replacer {
            request CAP_WRITE_BACK, 8
            out h
            out h_out
            read_reply r_status
            in ok
          }
          if ok {
            copy h_out -> current
            visit SET_NESTED, current, fresh
            addv removed, count
          } else {
            inc failures
          }
        }
      }
      node current
      visit_children current, MODE_LIST
    } else {
      if n_map {
        visit_children h, MODE_MAP_ENTRY
      } else {
        if n_array {
          visit_children h, MODE_ARRAY
        } else {
          # Reflection.shouldInspectChild, then every declared field.
          var inspect, facts, i[4], walking
          if n_collection { set inspect 1 }
          ifz inspect {
            copy n_facts -> facts
            ifz facts { class_facts h, facts }
            unpack_facts facts
            copy f_app_model -> inspect
          }
          if inspect {
            set walking 1
            while walking {
              lt i, n_size -> flag
              ifz flag {
                clear walking
              } else {
                child h, i, MODE_FIELD
                ifne r_status ST_OK {
                  clear walking
                } else {
                  if c_h {
                    visit_child
                    release c_h
                  }
                }
                inc i
              }
            }
          }
        }
      }
    }
  }
}

read_header
ifne rq_major ABI_MAJOR {
  respond ST_BAD_VERSION, 0
} else {
  switch rq_op {
    case OP_NESTED_SANITIZE {
      in h
      clear_visited SET_NESTED
      visit_value
      respond ST_OK, 8
      out removed, failures
    }
    case OP_NESTED_VISIT {
      in h, depth, budget, has_replacer, s_object, s_interface, s_arraylist
      visit_value
      respond ST_OK, 10
      out removed, failures, budget
    }
    default {
      respond ST_BAD_OPCODE, 0
    }
  }
}
