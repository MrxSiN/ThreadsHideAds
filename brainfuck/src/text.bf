# PROGRAM 1 text: runs one text matcher over a streamed string
#
# Hand written Brainfuck; see docs/BRAINFUCK_ABI for the frame format
# Request: the eight header bytes; the matcher id; the text as Java modified
# UTF8 ending in a zero byte
# Response: status OK and one verdict byte; or BAD OPCODE for an unknown
# matcher; or BAD VERSION when the major version is not 1
#
# House style: a comment never holds a command character; checkpoints like
# @c assert the data pointer; tildes assert run lengths; tools/bftool/lint
# checks both
#
# Switches use one shape everywhere so the AOT optimizer turns them into C
# switch statements: the subject X is copied into fX through tX; fX loses the
# case value; eX is set; a nonzero fX clears eX; eX runs the case body
# Three levels exist: A on m; B on s; C on c; each with its own f t e cells
#
# Tape
# %cell maj 0
# %cell min 1
# %cell op 2
# %cell flg 3
# %cell len 4 2
# %cell id 6 2
# %cell vx 8
# %cell vy 9
# %cell g 10
# %cell m 11
# %cell fA 12
# %cell tA 13
# %cell eA 14
# %cell s 15
# %cell fB 16
# %cell tB 17
# %cell eB 18
# %cell c 19
# %cell fC 20
# %cell tC 21
# %cell eC 22
# %cell n 23
# %cell v 24
# %cell run 25
# %cell known 26
# %cell lo 27
# %cell wt 28
# %cell u 29
# %cell wl 30
# %cell x 31
# %cell y 32
# %cell t1 33
# %cell ts 34
# %cell p 35
# %cell q 36
# %cell k 37 12
#
# m is the matcher; s the switch subject for machine states; c the current
# byte minus 96 once classified so lowercase letters are 1 to 26; n the next
# state; v the verdict; run keeps the byte loop going; lo says c was a byte
# from 1 to 32; ts holds the state of trie and string machines; k holds
# the state of each substring pattern

# == header
, > , > , > , > , > , > , > ,                 @id:1

# == version check: vx gets maj minus 1 and vy is the else flag
>> +                                          @vy
<<<<<<<<< ~9                                  @maj
[- >>>>>>>> ~8 + >> + <<<<<<<<<< ~10 ]        @maj
>>>>>>>>>> ~10                                @g
[- <<<<<<<<<< ~10 + >>>>>>>>>> ~10 ]          @g
<< -                                          @vx
[ > [-] <                                     @vx
  # BAD VERSION: 1 0 op|128 1 0 0 id
  >> + . - .                                  @g
  <<<<<<<< ~8                                 @op
  ++++++++++++++++ ++++++++++++++++ ++++++++++++++++ ++++++++++++++++ ++++++++++++++++ ++++++++++++++++ ++++++++++++++++ ++++++++++++++++ ~128 .
  ---------------- ---------------- ---------------- ---------------- ---------------- ---------------- ---------------- ---------------- ~128
  >>>>>>>> ~8 + . - . .                       @g
  <<<< . > .                                  @id:1
  >                                           @vx
[-] ]                                         @vx
> [                                           @vy

# == MAIN: read the matcher and set up its machine
>> ,                                          @m
# matcher setup: known and ts for every matcher; t1 is 1 for UNIT TYPE and
# STOP VALUE and 2 for STRUCTURED VALUE which keep the trie machine
[->+>+<<]>>[-<<+>>]< - ~1 >>+<<[>>[-]<<[-]]>>[ >>>>>>>>>>>> ~12 + >>>>>>>> ~8 + < + <<<<<<<<<<<<<<<<<<< ~19 [-]]<<< @m
[->+>+<<]>>[-<<+>>]< -- ~2 >>+<<[>>[-]<<[-]]>>[ >>>>>>>>>>>> ~12 + >>>>>>>> ~8 + < ++ <<<<<<<<<<<<<<<<<<< ~19 [-]]<<< @m
[->+>+<<]>>[-<<+>>]< --- ~3 >>+<<[>>[-]<<[-]]>>[ >>>>>>>>>>>> ~12 + >>>>>>>> ~8 + <<<<<<<<<<<<<<<<<<<< ~20 [-]]<<< @m
