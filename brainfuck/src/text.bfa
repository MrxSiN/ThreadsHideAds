# PROG_TEXT: runs one text matcher over a streamed string.
#
# Request  OP_TEXT_MATCH, flags FLAG_STREAM, len 1: matcher id, then the
#          modified-UTF-8 text terminated by 0.
# Response len 1: verdict (1 = the matcher accepted the text).
#
# Matchers stop reading as soon as the verdict cannot change.

include "frame.bfa"
include "vocabulary.bfa"

var matcher, verdict, known

read_header
ifne rq_major ABI_MAJOR {
  respond ST_BAD_VERSION, 0
} else {
  in matcher
  set known 1
  switch matcher {
    case MT_UNIT_TYPE { match UNIT_TYPE -> verdict }
    case MT_STRUCTURED_VALUE { match STRUCTURED_EXACT, STRUCTURED_CONTAINS -> verdict }
    case MT_FIELD_NAME { match FIELD_NAME -> verdict }
    case MT_STOP_VALUE { match STOP_VALUE -> verdict }
    case MT_CLASS_TOKEN { match CLASS_TOKEN -> verdict }
    case MT_APP_MODEL { match APP_MODEL -> verdict }
    case MT_PANDO_TREE_CLASS { match PANDO_TREE_CLASS -> verdict }
    case MT_AD_LABEL { match AD_LABEL -> verdict }
    case MT_NON_FEED_SIGNATURE { match NON_FEED_SIGNATURE -> verdict }
    case MT_BOOLEAN_NEGATIVE { match BOOLEAN_NEGATIVE -> verdict }
    case MT_BOOLEAN_POSITIVE { match BOOLEAN_POSITIVE -> verdict }
    case MT_THREADS_PACKAGE { match THREADS_PACKAGE -> verdict }
    case MT_LIST_CONTAINER { match LIST_CONTAINER -> verdict }
    case MT_DECOR_VIEW { match DECOR_VIEW -> verdict }
    default { clear known }
  }
  if known {
    respond ST_OK, 1
    out verdict
  } else {
    respond ST_BAD_OPCODE, 0
  }
}
