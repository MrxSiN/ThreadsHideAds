[->+>+<<]>>[-<<+>>]< --------- ~9 >>+<<[>>[-]<<[-]]>>[ >>>>>>>>>>>> ~12 + >>>>>>>> ~8 + <<<<<<<<<<<<<<<<<<<< ~20 [-]]<<< @m
[->+>+<<]>>[-<<+>>]< ---------- ~10 >>+<<[>>[-]<<[-]]>>[ >>>>>>>>>>>> ~12 + >>>>>>>> ~8 + <<<<<<<<<<<<<<<<<<<< ~20 [-]]<<< @m
[->+>+<<]>>[-<<+>>]< ----------- ~11 >>+<<[>>[-]<<[-]]>>[ >>>>>>>>>>>> ~12 + >>>>>>>> ~8 + <<<<<<<<<<<<<<<<<<<< ~20 [-]]<<< @m
[->+>+<<]>>[-<<+>>]< ------------ ~12 >>+<<[>>[-]<<[-]]>>[ >>>>>>>>>>>> ~12 + >>>>>>>> ~8 + <<<<<<<<<<<<<<<<<<<< ~20 [-]]<<< @m
[->+>+<<]>>[-<<+>>]< ------------- ~13 >>+<<[>>[-]<<[-]]>>[ >>>>>>>>>>>> ~12 + >>>>>>>> ~8 + <<<<<<<<<<<<<<<<<<<< ~20 [-]]<<< @m
[->+>+<<]>>[-<<+>>]< -------------- ~14 >>+<<[>>[-]<<[-]]>>[ >>>>>>>>>>>> ~12 + >>>>>>>> ~8 + <<<<<<<<<<<<<<<<<<<< ~20 [-]]<<< @m
# run starts as known
>>>>>>>>>>>>>>> ~15                           @known
[- < + >>>>>> ~6 + <<<<< ~5 ]                 @known
>>>>> ~5                                      @x
[- <<<<< ~5 + >>>>> ~5 ]                      @x
<<<<<< ~6                                     @run

# == byte loop
[
  <<<<<< ~6 ,                                 @c
  # x gets a copy of c through y; then y becomes the else flag
  [- >>>>>>>>>>>> ~12 + > + <<<<<<<<<<<<< ~13 ] @c
  >>>>>>>>>>>>> ~13                           @y
  [- <<<<<<<<<<<<< ~13 + >>>>>>>>>>>>> ~13 ]   @y
  +
  < [ > [-] <                                 @x
    <<<<<<<<<<<< ~12                          @c
    # lo is 1 when c is a byte from 1 to 32
[->+>+<<]>>[-<<+>>]< - ~1 >>+<<[>>[-]<<[-]]>>[ >>>>> + <<<<< [-]]<<< @c
[->+>+<<]>>[-<<+>>]< -- ~2 >>+<<[>>[-]<<[-]]>>[ >>>>> + <<<<< [-]]<<< @c
[->+>+<<]>>[-<<+>>]< --- ~3 >>+<<[>>[-]<<[-]]>>[ >>>>> + <<<<< [-]]<<< @c
