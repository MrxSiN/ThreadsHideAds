        <                                                             @eB
      [-]]<<<                                                         @s
      # 203: C0 then 80 is back to LEAD
      [->+>+<<]>>[-<<+>>]< ++++++++++ ++++++++++ ++++++++++ ++++++++++ ++++++++++ +++ ~53 >>+<<[>>[-]<<[-]]>>[ > [->+>+<<]>>[-<<+>>]< ---------- ---------- ---------- -- ~32 >>+<<[>>[-]<<[-]]>>[ >[-]+< [-]]<<< < [-]]<<< @s
