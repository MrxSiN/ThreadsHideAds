# Capability calls shared by the policy programs. Each macro writes one
# request frame, reads the whole reply and leaves r_status set. A failed
# capability answers zeros, so every caller fails open.
# Frame layouts: docs/BRAINFUCK_ABI.md, "Capabilities".

include "frame.bfa"
include "limits.bfa"

var r_status
var zero16[2]

# ---- object descriptors (CAP_NODE, CAP_CHILD)
# kind flags, class facts memo, size (container length or text length),
# value (Number.longValue(), or 1/0 for Boolean), cached Pando verdict
# (0 unknown, 1 not sponsored, 2 sponsored; only for known Pando classes)

var n_charseq, n_enum, n_number, n_boolean, n_character, n_class
var n_map, n_collection, n_list, n_array, n_facts, n_size[4], n_value[8], n_tree

var c_h[4], c_charseq, c_enum, c_number, c_boolean, c_character, c_class
var c_map, c_collection, c_list, c_array, c_facts, c_size[4], c_value[8], c_tree
var c_decl_object, c_decl_interface, c_decl_arraylist, c_field_fact, c_key[4]

macro node(h) {
  cap CAP_NODE, h
  read_reply r_status
  in n_charseq, n_enum, n_number, n_boolean, n_character, n_class
  in n_map, n_collection, n_list, n_array, n_facts, n_size, n_value, n_tree
}

# child(h, index[4], mode): the index-th element, entry value or field.
macro child(h, index, mode) {
  cap CAP_CHILD, h, index, mode
  read_reply r_status
  in c_h, c_charseq, c_enum, c_number, c_boolean, c_character, c_class
  in c_map, c_collection, c_list, c_array, c_facts, c_size, c_value, c_tree
  in c_decl_object, c_decl_interface, c_decl_arraylist, c_field_fact, c_key
}

# visit(set, h, fresh): fresh := h was not yet in identity set `set`.
macro visit(set, h, fresh) {
  cap CAP_VISIT, set, VISIT_ADD, h
  read_reply r_status
  in fresh
}

# visit_first(set, h, fresh): starts a traversal: clears the set, adds h.
macro visit_first(set, h, fresh) {
  cap CAP_VISIT, set, VISIT_RESET_ADD, h
  read_reply r_status
  in fresh
}

macro clear_visited(set) {
  var ignored, none[4]
  cap CAP_VISIT, set, VISIT_CLEAR, none
  read_reply r_status
  in ignored
  clear ignored
}

# Per-class memo of the object's runtime class. index is a 2-byte cell: a
# field index for SLOT_FIELD, zero16 otherwise.
macro memo_get(h, slot, index, value) {
  cap CAP_MEMO_GET, h, slot, 0, index
  read_reply r_status
  in value
}

macro memo_put(h, slot, index, value) {
  var ignored
  cap CAP_MEMO_PUT, h, slot, value, index
  read_reply r_status
  in ignored
  clear ignored
}

# Frees every handle allocated at or after h (h = 0 frees nothing).
macro release(h) {
  cap CAP_RELEASE, h
  read_reply r_status
}

# text(matcher, h, source, transform, verdict): runs a vocabulary matcher of
# PROG_TEXT over the text the host reads from h.
macro text(matcher, h, source, transform, verdict) {
  request CAP_CALL, 11
  outc PROG_TEXT
  outc OP_TEXT_MATCH
  outc 1
  outc 1
  out matcher
  out h
  out source
  out transform
  read_reply r_status
  in verdict
}

# detect(h, depth, budget[2], found): one ReflectiveAdDetector.inspect step
# in PROG_DETECT; budget is shared across the whole traversal.
macro detect(h, depth, budget, found) {
  call PROG_DETECT, OP_DETECT, h, depth, budget, 0
  read_reply r_status
  in found
  in budget
}

# detect_child(depth, budget, found): detect on the current child, handing
# over the descriptor CAP_CHILD already returned.
macro detect_child(depth, budget, found) {
  call PROG_DETECT, OP_DETECT, c_h, depth, budget, 1, c_charseq, c_enum, c_number, c_boolean, c_character, c_class, c_map, c_collection, c_list, c_array, c_facts, c_size, c_value, c_tree
  read_reply r_status
  in found
  in budget
}

# class_facts(h, facts): packed facts of h's runtime class, computed once.
macro class_facts(h, facts) {
  call PROG_DETECT, OP_CLASS_FACTS, h
  read_reply r_status
  in facts
}

# pando_verdict(h, facts, tree, sponsored): PandoAdSignals.isSponsoredTree
# in PROG_PANDO, handing over the class facts and cached verdict already known
# (0 when not).
macro pando_verdict(h, facts, tree, sponsored) {
  call PROG_PANDO, OP_PANDO_VERDICT, h, facts, tree
  read_reply r_status
  in sponsored
}

# ---- list mutation (the host keeps the marked indexes of one list)

# reset_marks(h): forget any marks, the next ones belong to list h.
macro reset_marks(h) {
  var all[4]
  set all 0xFFFFFFFF
  cap CAP_MARK, h, all
  read_reply r_status
}

macro mark(h, index) {
  cap CAP_MARK, h, index
  read_reply r_status
}

# removed := entries removed in place, backwards, until one removal fails.
macro remove_marked(h, removed) {
  cap CAP_REMOVE_MARKED, h
  read_reply r_status
  in removed
}

# copy := new ArrayList of the unmarked entries.
macro filtered_copy(h, copy) {
  cap CAP_FILTERED_COPY, h
  read_reply r_status
  in copy
}

# report(site, index, count[4]): removal accounting for the host's log.
macro report(site, index, count) {
  cap CAP_REPORT, site, index, count
  read_reply r_status
}

# Unpacked class facts (see detect.bfa, "Class facts").
var f_known, f_app_model, f_strong_token, f_pando, f_structured

macro unpack_facts(facts) {
  unpack facts -> f_known, f_app_model, f_strong_token, f_pando, f_structured
}
