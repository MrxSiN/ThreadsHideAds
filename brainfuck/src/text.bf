        [->+>+<<]>>[-<<+>>]< ---- ~4 >>+<<[>>[-]<<[-]]>>[ >[-] ---------- ---------- ---------- ---------- ---------- ---------- ---------- ---------- ---------- ---------- ---------- ---------- ------- ~127 < [-]]<<< @c
