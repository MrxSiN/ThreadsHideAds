# PROG_CORE: lifecycle, initialization/retry, discovery, compatibility names,
# rate-limited statistics and the rendered-label fallback decisions.
#
# The only program with persistent cells: they survive between requests and
# are cleared by OP_RESET. Ports MainHook, ModelHookInstaller,
# FeedBoundaryFinder/FeedCacheLocator classification, PandoResponseHooks
# accessor selection, ModuleStats, and the FeedItemHider/AdLabelScanner/
# ViewTrees/RenderedLabelHooks decisions of v1.2.1.

include "lib.bfa"

# ---- persistent state (docs/BRAINFUCK_MEMORY_MAP.md)
persist ui_installed, attach_requested, initialized, initializing
persist attempts[4]
persist primary_count[2], injector_count
persist removal_total[4], removal_events[4], removal_cycle
persist ui_total[4], ui_cycle
persist replace_failures[4], replace_cycle

const RETRY_ATTEMPTS = 3
const MAX_PRIMARY_BOUNDARIES = 8
const MAX_ANCESTOR_DEPTH = 14
const MAX_LIST_CONTAINER_DEPTH = 8
const MAX_LAYOUT_RETRIES = 4
const MAX_SCAN_VIEWS = 320
const MAX_RESCAN_VIEWS = 160
const MAX_CHILDREN_PER_GROUP = 64
const MIN_CARD_HEIGHT_DP = 80

# OP_INIT_* actions and reasons
const INIT_IGNORE = 0
const INIT_START = 1
const INIT_RETRY = 2
const INIT_EXHAUSTED = 3
const INIT_COMPLETE = 4
const REASON_NONE = 0
const REASON_NULL_LOADER = 1
const REASON_UNSUCCESSFUL = 2
const REASON_BUSY = 3
const REASON_INITIALIZED = 4

# OP_INSTALL_STEP steps
const STEP_BEGIN = 0
const STEP_PANDO = 1
const STEP_LOAD_NATIVE = 2
const STEP_OPEN_LOADER = 3
const STEP_OPEN_APK = 4
const STEP_FEED_CACHE = 5
const STEP_PRIMARY = 6
const STEP_BROAD = 7
const STEP_DONE = 254
const STEP_ABORT = 255
const DONE_PRIMARY = 1
const DONE_BROAD = 2
const DONE_DUPLICATE_SKIPPED = 3

# OP_PRIMARY_DECISION / OP_INJECTOR_DECISION reasons
const DECISION_NONE = 0
const DECISION_TOO_BROAD = 1
const DECISION_INSTALL = 2
const DECISION_AMBIGUOUS = 3

# OP_BROAD_CANDIDATE actions
const BROAD_SKIP = 0
const BROAD_LIST = 1
const BROAD_BOOLEAN = 2

# OP_STATS kinds
const STAT_MODEL_REMOVAL = 1
const STAT_UI_COLLAPSE = 2
const STAT_REPLACEMENT_FAILURE = 3

# OP_UI_* actions
const UI_HIDE = 1
const UI_RESTORE = 2
const HIDE_NONE = 0
const HIDE_CARD = 1
const HIDE_RETRY = 2
const HIDE_LABEL = 3
const CARD_NONE = 0xFE
const CARD_LABEL = 0xFF

# OP_CONST_STRING tables
const TABLE_FEED_OWNERS = 0
const TABLE_DEX_MARKERS = 1
const TABLE_NAMES = 2
const NAME_PRIMARY_MARKER = 0
const NAME_PANDO_TREE = 1
const NAME_APPLICATION = 2
const NAME_ATTACH = 3
const NAME_DEXKIT_LIBRARY = 4
const NAME_COPY_FACTORY = 5
const NAME_SPOOL_HANDLER = 6

var flag, go, value, index, count

macro str_response(s) {
  respond ST_OK, len(s)
  outs s
}

# ModelHookInstaller.scheduleRetry(retryIndex)
macro schedule_retry(retry_index, reason) {
  var ahead
  if initialized {
    respond ST_OK, 11
    outc INIT_IGNORE
    outc REASON_INITIALIZED
    outc32 0
    outc32 0
    outc 0
  } else {
    lt retry_index, RETRY_ATTEMPTS -> ahead
    if ahead {
      copy retry_index -> index
      inc index
      respond ST_OK, 11
      outc INIT_RETRY
      out reason
      out attempts
      switch retry_index {
        case 0 { outc32 250 }
        case 1 { outc32 1000 }
        default { outc32 3000 }
      }
      out index
    } else {
      respond ST_OK, 11
      outc INIT_EXHAUSTED
      out reason
      out attempts
      outc32 0
      outc 0
    }
  }
}

# Card search (FeedItemHider.findFeedCard). Payload: count, screen width[2],
# screen height[2], density[4] as 16.16 fixed point, then per ancestor
# (nearest first): list container, root or decor, width[2], height[2].
macro find_card() {
  var sw[4], sh[4], density[4], minimum[4], product[4], result, current, depth, walking
  var list_container, root, w[4], h[4], lhs[4], rhs[4], ok
  in count
  in sw[0], sw[1], sh[0], sh[1], density
  # max(80, (int) (80 * density))
  repeat MIN_CARD_HEIGHT_DP { addv product, density }
  copy product[2] -> minimum[0]
  copy product[3] -> minimum[1]
  lt minimum, MIN_CARD_HEIGHT_DP -> flag
  if flag { set minimum MIN_CARD_HEIGHT_DP }
  clear flag
  set result CARD_NONE
  set current CARD_LABEL
  set walking 1
  lt depth, count -> flag
  ifz flag { clear walking }
  while walking {
    in list_container, root, w[0], w[1], h[0], h[1]
    # A direct child of a RecyclerView/ListView, other than the label.
    clear go
    if list_container {
      ifne current CARD_LABEL { set go 1 }
    }
    if go {
      copy current -> result
      clear walking
    } else {
      # A wide, bounded ancestor at least two levels up.
      gt depth, 1 -> ok
      if ok {
        # w >= 0.70 * screen width, exactly for float operands < 2^24.
        clear lhs, rhs
        repeat 10 { addv lhs, w }
        repeat 7 { addv rhs, sw }
        ge lhs, rhs -> ok
      }
      if ok {
        ge h, minimum -> ok
      }
      if ok {
        clear lhs, rhs
        repeat 10 { addv lhs, h }
        repeat 8 { addv rhs, sh }
        le lhs, rhs -> ok
      }
      if ok { copy depth -> result }
      if root { clear walking }
      copy depth -> current
    }
    inc depth
    ifeq depth MAX_ANCESTOR_DEPTH { clear walking }
    lt depth, count -> flag
    ifz flag { clear walking }
    clear ok, go
  }
  respond ST_OK, 1
  out result
}

# AdLabelScanner.isCurrentAdMarker for a view handle.
macro is_marker(view, text_view, marker) {
  clear marker
  if text_view {
    text MT_AD_LABEL, view, SRC_VIEW_TEXT, TX_LOWER_ROOT, marker
  }
  ifz marker {
    text MT_AD_LABEL, view, SRC_VIEW_DESCRIPTION, TX_LOWER_ROOT, marker
  }
}

# Rate limit: total <= first || total % period == 0, with `cycle` counting
# total modulo period.
macro rate_limit(total, cycle, first, period, log) {
  inc cycle
  ifeq cycle period { clear cycle }
  le total, first -> log
  ifz cycle { set log 1 }
}

read_header
ifne rq_major ABI_MAJOR {
  respond ST_BAD_VERSION, 0
} else {
  switch rq_op {

    # ---- MainHook.handleLoadPackage: payload package h[4], process h[4]
    case OP_LOAD_PACKAGE {
      var package_h[4], process_h[4], in_scope, main_process, install_ui, install_attach
      in package_h, process_h
      text MT_THREADS_PACKAGE, package_h, SRC_STRING, TX_RAW, in_scope
      if in_scope {
        # Secondary processes are skipped; a null process name is main.
        set main_process 1
        if process_h {
          text MT_THREADS_PACKAGE, process_h, SRC_STRING, TX_RAW, main_process
        }
        copy main_process -> in_scope
      }
      if in_scope {
        ifz ui_installed {
          set ui_installed 1
          set install_ui 1
        }
        ifz attach_requested {
          set attach_requested 1
          set install_attach 1
        }
      }
      respond ST_OK, 3
      out in_scope, install_ui, install_attach
    }

    # The attach hook could not be installed: initialize from the
    # load-package class loader instead.
    case OP_ATTACH_GUARD_FAILED {
      respond ST_OK, 1
      outc 1
    }

    # ---- ModelHookInstaller.request: payload loader present, retry index
    case OP_INIT_REQUEST {
      var loader, retry_index
      in loader, retry_index
      if initialized {
        respond ST_OK, 11
        outc INIT_IGNORE
        outc REASON_INITIALIZED
        outc32 0
        outc32 0
        outc 0
      } else {
        ifz loader {
          schedule_retry retry_index, REASON_NULL_LOADER
        } else {
          if initializing {
            respond ST_OK, 11
            outc INIT_IGNORE
            outc REASON_BUSY
            outc32 0
            outc32 0
            outc 0
          } else {
            set initializing 1
            inc attempts
            respond ST_OK, 11
            outc INIT_START
            outc REASON_NONE
            out attempts
            outc32 0
            outc 0
          }
        }
      }
    }

    # ---- attempt finished: payload success, retry index
    case OP_INIT_FINISH {
      var success, retry_index
      in success, retry_index
      if success { set initialized 1 }
      clear initializing
      if success {
        respond ST_OK, 11
        outc INIT_COMPLETE
        outc REASON_NONE
        out attempts
        outc32 0
        outc 0
      } else {
        schedule_retry retry_index, REASON_UNSUCCESSFUL
      }
    }

    # ---- ModelHookInstaller.installHooks order: payload step, ok, aux,
    # feed hooks[2], pando hooks[2] -> next step, success, detail
    case OP_INSTALL_STEP {
      var step, ok, aux, feed[2], pando[2], next, success, detail
      in step, ok, aux, feed, pando
      switch step {
        case STEP_BEGIN { set next STEP_PANDO }
        case STEP_PANDO { set next STEP_LOAD_NATIVE }
        case STEP_LOAD_NATIVE {
          set next STEP_ABORT
          if ok { set next STEP_OPEN_LOADER }
        }
        case STEP_OPEN_LOADER {
          set next STEP_ABORT
          if aux { set next STEP_OPEN_APK }
          if ok { set next STEP_FEED_CACHE }
        }
        case STEP_OPEN_APK {
          set next STEP_ABORT
          if ok { set next STEP_FEED_CACHE }
        }
        case STEP_FEED_CACHE {
          clear primary_count
          set next STEP_PRIMARY
        }
        case STEP_PRIMARY {
          set next STEP_DONE
          if aux {
            set detail DONE_PRIMARY
          } else {
            ifz feed {
              set next STEP_BROAD
            } else {
              set detail DONE_DUPLICATE_SKIPPED
            }
          }
        }
        case STEP_BROAD {
          set next STEP_DONE
          set detail DONE_BROAD
        }
        default { set next STEP_ABORT }
      }
      ifeq next STEP_DONE {
        if feed { set success 1 }
        if pando { set success 1 }
      }
      respond ST_OK, 3
      out next, success, detail
    }

    # ---- FeedBoundaryFinder.isPrimaryFeedBoundaryShape
    case OP_PRIMARY_CANDIDATE {
      var is_static, is_abstract, interface, params, p0, p1, p2, returns_void, accept
      in is_static, is_abstract, interface, params, p0, p1, p2, returns_void
      set accept 1
      if is_static { clear accept }
      if is_abstract { clear accept }
      if interface { clear accept }
      ifne params 3 { clear accept }
      ifz p0 { clear accept }
      ifz p1 { clear accept }
      ifz p2 { clear accept }
      if returns_void { clear accept }
      if accept { inc primary_count }
      respond ST_OK, 1
      out accept
    }

    # Installed only for 1..MAX_PRIMARY_BOUNDARIES structural matches.
    case OP_PRIMARY_DECISION {
      var decision
      set decision DECISION_INSTALL
      ifz primary_count { set decision DECISION_NONE }
      gt primary_count, MAX_PRIMARY_BOUNDARIES -> flag
      if flag { set decision DECISION_TOO_BROAD }
      respond ST_OK, 3
      out decision, primary_count
      clear primary_count
    }

    # ---- FeedBoundaryFinder broad classification: payload list boundary,
    # returns boolean, method h[4], 13 marker flags (DEX_MARKERS order)
    case OP_BROAD_CANDIDATE {
      var list_boundary, returns_boolean, method[4], m[13], any, strong, blocked, action
      in list_boundary, returns_boolean, method
      in m[0], m[1], m[2], m[3], m[4], m[5], m[6], m[7], m[8], m[9], m[10], m[11], m[12]
      # Every DEX marker counts for a list boundary; the strong boolean
      # markers are is_sponsored, isSponsored, sponsored_label, direct_ad, directAd.
      if m[0] { set any 1 }
      if m[1] { set any 1 }
      if m[2] { set any 1 }
      if m[3] { set any 1 }
      if m[4] { set any 1 }
      if m[5] { set any 1 }
      if m[6] { set any 1 }
      if m[7] { set any 1 }
      if m[8] { set any 1 }
      if m[9] { set any 1 }
      if m[10] { set any 1 }
      if m[11] { set any 1 }
      if m[12] { set any 1 }
      if m[0] { set strong 1 }
      if m[1] { set strong 1 }
      if m[2] { set strong 1 }
      if m[5] { set strong 1 }
      if m[6] { set strong 1 }
      set action BROAD_SKIP
      clear go
      if list_boundary {
        if any { set go 1 }
      }
      if go {
        text MT_NON_FEED_SIGNATURE, method, SRC_METHOD_SIGNATURE, TX_LOWER_ROOT, blocked
        ifz blocked { set action BROAD_LIST }
      }
      ifeq action BROAD_SKIP {
        if returns_boolean {
          text MT_BOOLEAN_NEGATIVE, method, SRC_METHOD_SEMANTIC, TX_LOWER_ROOT, blocked
          ifz blocked {
            text MT_BOOLEAN_POSITIVE, method, SRC_METHOD_SEMANTIC, TX_LOWER_ROOT, value
            if strong { set value 1 }
            if value { set action BROAD_BOOLEAN }
          }
        }
      }
      respond ST_OK, 1
      out action
    }

    # ---- FeedCacheLocator.findListBoundaries: abstract, returns List,
    # takes a List
    case OP_FEED_OWNER_METHOD {
      var is_abstract, returns_list, takes_list, hook
      in is_abstract, returns_list, takes_list
      if returns_list { set hook 1 }
      if takes_list { set hook 1 }
      if is_abstract { clear hook }
      respond ST_OK, 1
      out hook
    }

    # ---- FeedCacheLocator.isAdInjectionShape: abstract, returns boolean
    # primitive, parameter count, first parameter primitive, second int
    case OP_INJECTOR_METHOD {
      var is_abstract, returns_boolean, params, p0_primitive, p1_int, shape
      in is_abstract, returns_boolean, params, p0_primitive, p1_int
      set shape 1
      if is_abstract { clear shape }
      ifz returns_boolean { clear shape }
      ifne params 2 { clear shape }
      if p0_primitive { clear shape }
      ifz p1_int { clear shape }
      if shape {
        ifne injector_count 255 { inc injector_count }
      }
      respond ST_OK, 1
      out shape
    }

    # Installed only when exactly one method has the injector shape.
    case OP_INJECTOR_DECISION {
      var decision
      set decision DECISION_AMBIGUOUS
      ifz injector_count { set decision DECISION_NONE }
      ifeq injector_count 1 { set decision DECISION_INSTALL }
      clear injector_count
      respond ST_OK, 1
      out decision
    }

    # ---- PandoResponseHooks.isListAccessor: abstract, native, returns List
    case OP_PANDO_ACCESSOR {
      var is_abstract, is_native, returns_list, hook
      in is_abstract, is_native, returns_list
      copy returns_list -> hook
      if is_abstract { clear hook }
      if is_native { clear hook }
      respond ST_OK, 1
      out hook
    }

    # ---- names the host needs to find things: payload table, index
    case OP_CONST_STRING {
      var table
      in table, index
      set go 1
      switch table {
        case TABLE_FEED_OWNERS {
          switch index {
            case 0 { str_response "com.instagram.barcelona.feed.data.cache.BarcelonaSpoolFeedCacheHandler" }
            case 1 { str_response "com.instagram.barcelona.feed.data.cache.BarcelonaFeedCacheHandler" }
            case 2 { str_response "com.instagram.barcelona.feed.data.cache.BarcelonaFeedCacheHandlerBase" }
            case 3 { str_response "com.instagram.barcelona.feed.data.cache.BarcelonaFeedCache" }
            case 4 { str_response "com.instagram.barcelona.feed.data.cache.BarcelonaFeedCacheRoom" }
            case 5 { str_response "com.instagram.barcelona.feed.common.data.InMemoryFeedCache" }
            case 6 { str_response "com.instagram.barcelona.feed.common.data.BcnFeedRepository" }
            case 7 { str_response "com.instagram.barcelona.feed.data.repository.BarcelonaFeedRepository" }
            case 8 { str_response "com.instagram.barcelona.feed.data.repository.ForYouFeedRepository" }
            case 9 { str_response "com.instagram.barcelona.feed.data.spool.ForYouFeedSpoolStateMapper" }
            case 10 { str_response "com.instagram.barcelona.feed.data.networksource.BarcelonaFeedNetworkSource" }
            case 11 { str_response "com.instagram.barcelona.feed.data.networksource.BarcelonaSpoolFeedNetworkSource" }
            case 12 { str_response "com.instagram.barcelona.feed.data.networksource.FollowingFeedNetworkSource" }
            case 13 { str_response "com.instagram.barcelona.feed.data.prefetch.BcnInjectedPostPrefetcher" }
            case 14 { str_response "com.instagram.barcelona.feed.data.cache.BarcelonaFeedItemDatabase" }
            default { clear go }
          }
        }
        case TABLE_DEX_MARKERS {
          # Broad words such as plain "ad" match thousands of methods.
          switch index {
            case 0 { str_response "is_sponsored" }
            case 1 { str_response "isSponsored" }
            case 2 { str_response "sponsored_label" }
            case 3 { str_response "Sponsored" }
            case 4 { str_response "sponsored" }
            case 5 { str_response "direct_ad" }
            case 6 { str_response "directAd" }
            case 7 { str_response "ad_type" }
            case 8 { str_response "ad_id" }
            case 9 { str_response "adchoices" }
            case 10 { str_response "AdChoices" }
            case 11 { str_response "multi_ads" }
            case 12 { str_response "MultiAds" }
            default { clear go }
          }
        }
        case TABLE_NAMES {
          switch index {
            case NAME_PRIMARY_MARKER { str_response "Sponsored" }
            case NAME_PANDO_TREE { str_response "com.facebook.pando.TreeJNI" }
            case NAME_APPLICATION { str_response "android.app.Application" }
            case NAME_ATTACH { str_response "attach" }
            case NAME_DEXKIT_LIBRARY { str_response "dexkit" }
            case NAME_COPY_FACTORY { str_response "copyOf" }
            case NAME_SPOOL_HANDLER { str_response "com.instagram.barcelona.feed.data.cache.BarcelonaSpoolFeedCacheHandler" }
            default { clear go }
          }
        }
        default { clear go }
      }
      ifz go { respond ST_NOT_FOUND, 0 }
    }

    # ---- bounds the host applies while reading objects and views
    case OP_LIMITS {
      respond ST_OK, 3
      outc FIELD_CLASS_DEPTH
      outc MAX_ANCESTOR_DEPTH
      outc MAX_LIST_CONTAINER_DEPTH + 1
    }

    # ---- ModuleStats: payload kind, count[4] -> log, total[4], event[4]
    case OP_STATS {
      var kind, amount[4], log
      in kind, amount
      switch kind {
        case STAT_MODEL_REMOVAL {
          if amount {
            addv removal_total, amount
            inc removal_events
            rate_limit removal_events, removal_cycle, 12, 25, log
          }
          respond ST_OK, 9
          out log, removal_total, removal_events
        }
        case STAT_UI_COLLAPSE {
          inc ui_total
          rate_limit ui_total, ui_cycle, 8, 25, log
          respond ST_OK, 9
          out log, ui_total, ui_total
        }
        case STAT_REPLACEMENT_FAILURE {
          inc replace_failures
          rate_limit replace_failures, replace_cycle, 3, 10, log
          respond ST_OK, 9
          out log, replace_failures, replace_failures
        }
        default { respond ST_BAD_FRAME, 0 }
      }
    }

    # ---- RenderedLabelHooks: payload source (0 text, 1 description), view h[4]
    case OP_UI_TEXT_EVENT {
      var source, view[4], label, action
      in source, view
      ifz source {
        text MT_AD_LABEL, view, SRC_VIEW_TEXT, TX_LOWER_ROOT, label
      } else {
        text MT_AD_LABEL, view, SRC_VIEW_DESCRIPTION, TX_LOWER_ROOT, label
      }
      set action UI_RESTORE
      if label { set action UI_HIDE }
      respond ST_OK, 1
      out action
    }

    # ---- AdLabelScanner.isCurrentAdMarker: payload view h[4], is TextView
    case OP_UI_MARKER {
      var view[4], text_view, marker
      in view, text_view
      is_marker view, text_view, marker
      respond ST_OK, 1
      out marker
    }

    case OP_UI_CARD {
      find_card
    }

    # ---- FeedItemHider.hide: payload marker, card found, attempt,
    # retry could not be armed -> action, next attempt
    case OP_UI_HIDE {
      var marker, card, attempt, arm_failed, action, next
      in marker, card, attempt, arm_failed
      set action HIDE_NONE
      if marker {
        set action HIDE_LABEL
        if card {
          set action HIDE_CARD
        } else {
          lt attempt, MAX_LAYOUT_RETRIES -> flag
          if arm_failed { clear flag }
          if flag {
            set action HIDE_RETRY
            copy attempt -> next
            inc next
          }
        }
      }
      respond ST_OK, 2
      out action, next
    }

    # ---- FeedItemHider.restoreMarkedAncestor: payload hidden by this
    # label, subtree still labelled
    case OP_UI_RESTORE {
      var same, labelled, restore
      in same, labelled
      copy same -> restore
      if labelled { clear restore }
      respond ST_OK, 1
      out restore
    }

    # ---- AdLabelScanner.findAdLabel: payload root h[4], rescan -> view h[4]
    case OP_UI_SCAN {
      var root[4], rescan, limit[2], seen[2], view[4], text_view, marker, found[4], reset
      in root, rescan
      set limit MAX_SCAN_VIEWS
      if rescan { set limit MAX_RESCAN_VIEWS }
      set reset 1
      set go 1
      while go {
        lt seen, limit -> flag
        ifz flag {
          clear go
        } else {
          request CAP_SCAN_NEXT, 6
          out root
          outc MAX_CHILDREN_PER_GROUP
          out reset
          read_reply r_status
          in view, text_view
          clear reset
          ifz view {
            clear go
          } else {
            inc seen
            is_marker view, text_view, marker
            if marker {
              copy view -> found
              clear go
            }
          }
        }
      }
      respond ST_OK, 4
      out found
    }

    # ---- ViewTrees.isListContainer / isDecorView for a view's class,
    # memoized per class: payload view h[4] -> list container, decor view
    case OP_UI_VIEW_CLASS {
      var view[4], memo, list_container, decor, k, super[4], first[4], walking, hit
      in view
      memo_get view, SLOT_VIEW, zero16, memo
      ifz memo {
        set walking 1
        while walking {
          request CAP_SUPERCLASS, 5
          out view
          out k
          read_reply r_status
          in super
          ifz super {
            clear walking
          } else {
            ifz first { copy super -> first }
            ifz list_container {
              text MT_LIST_CONTAINER, super, SRC_TYPE_NAME, TX_RAW, list_container
            }
            ifz decor {
              text MT_DECOR_VIEW, super, SRC_TYPE_NAME, TX_RAW, decor
            }
          }
          inc k
          ifeq k MAX_SUPERCLASS_WALK { clear walking }
        }
        release first
        set memo 1
        if list_container { add memo 1 }
        if decor { add memo 2 }
        memo_put view, SLOT_VIEW, zero16, memo
      }
      clear list_container, decor
      sub memo 1
      ifeq memo 1 { set list_container 1 }
      ifeq memo 2 { set decor 1 }
      ifeq memo 3 {
        set list_container 1
        set decor 1
      }
      respond ST_OK, 2
      out list_container, decor
    }

    # ---- RenderedLabelHooks addView: payload count, then list-container
    # flags for the parent and its ancestors -> scan the added subtree
    case OP_UI_ADD_VIEW {
      var within, entry, scanned
      in count
      set go 1
      ifz count { clear go }
      while go {
        in entry
        if entry { set within 1 }
        inc scanned
        ifeq scanned MAX_LIST_CONTAINER_DEPTH + 1 { clear go }
        copy count -> flag
        subv flag, scanned
        ifz flag { clear go }
      }
      respond ST_OK, 1
      out within
    }

    case OP_RESET {
      clear ui_installed, attach_requested, initialized, initializing, attempts
      clear primary_count, injector_count
      clear removal_total, removal_events, removal_cycle
      clear ui_total, ui_cycle, replace_failures, replace_cycle
      respond ST_OK, 0
    }

    case OP_VERSION {
      respond ST_OK, 2
      outc ABI_MAJOR
      outc ABI_MINOR
    }

    default {
      respond ST_BAD_OPCODE, 0
    }
  }
}
