[->+>+<<]>>[-<<+>>]< ------------------------- ~25 >>+<<[>>[-]<<[-]]>>[ >>>>> + <<<<< [-]]<<< @c
[->+>+<<]>>[-<<+>>]< -------------------------- ~26 >>+<<[>>[-]<<[-]]>>[ >>>>> + <<<<< [-]]<<< @c
[->+>+<<]>>[-<<+>>]< --------------------------- ~27 >>+<<[>>[-]<<[-]]>>[ >>>>> + <<<<< [-]]<<< @c
[->+>+<<]>>[-<<+>>]< ---------------------------- ~28 >>+<<[>>[-]<<[-]]>>[ >>>>> + <<<<< [-]]<<< @c
[->+>+<<]>>[-<<+>>]< ----------------------------- ~29 >>+<<[>>[-]<<[-]]>>[ >>>>> + <<<<< [-]]<<< @c
