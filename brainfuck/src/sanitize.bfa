# PROG_SANITIZE: feed-list sanitization and the feed-boundary hook flow.
#
# Ports v1.2.1 ListSanitizer.sanitize and FeedModelHooks' before/after
# callbacks. The host removes, copies and assigns; every decision is here.
#
# OP_SANITIZE_LIST  h[4], declared object|null, declared interface,
#                   declared accepts ArrayList, allow replacement,
#                   allow emptying
#                   -> changed, result h[4], removed[4], blocked
# OP_BOUNDARY_BEFORE argc               -> 0 (removals via CAP_REPORT)
# OP_BOUNDARY_AFTER  argc, threw        -> 0

include "lib.bfa"

var h[4], d_object, d_interface, d_arraylist, allow_replacement, allow_emptying
var changed, h_out[4], removed[4], blocked
var argc, threw, index, looping, flag
var a_h[4], a_list, p_object, p_interface, p_arraylist, r_object, r_interface, r_arraylist

# ListSanitizer.sanitize(value, declaredType, allowReplacement, allowEmptying)
macro sanitize_list() {
  var ads[4], kept[4], i[4], walking, failed, ad, root_depth, root_budget[2], moved[4], can_replace
  clear changed, removed, blocked
  copy h -> h_out
  node h
  if n_list {
    reset_marks h
    set walking 1
    while walking {
      lt i, n_size -> flag
      ifz flag {
        clear walking
      } else {
        child h, i, MODE_LIST
        ifne r_status ST_OK {
          # list.get threw: the legacy callback threw and changed nothing.
          clear walking
          set failed 1
        } else {
          clear ad
          # A nested list is a container, not a feed item.
          ifz c_list {
            clear root_depth, root_budget
            detect c_h, root_depth, root_budget, ad
          }
          if ad {
            mark h, i
            inc ads
          } else {
            inc kept
          }
          if c_h { release c_h }
        }
        inc i
      }
    }
    ifz failed {
      if ads {
        ifz kept {
          ifz allow_emptying { set blocked 1 }
        }
        ifz blocked {
          remove_marked h, moved
          if moved {
            set changed 1
            copy moved -> removed
          } else {
            if allow_replacement {
              if d_object { set can_replace 1 }
              if d_interface { set can_replace 1 }
              if d_arraylist { set can_replace 1 }
              if can_replace {
                filtered_copy h, h_out
                if h_out {
                  set changed 1
                  copy ads -> removed
                } else {
                  copy h -> h_out
                }
              }
            }
          }
        }
      }
    }
  }
}

# arg(index): parameter or result (index RESULT_INDEX) of the hooked call.
macro arg(which) {
  cap CAP_ARG, which
  read_reply r_status
  in a_h, a_list, p_object, p_interface, p_arraylist, r_object, r_interface, r_arraylist
}

macro set_arg(which, value) {
  cap CAP_SET_ARG, which, value
  read_reply r_status
}

# The list sanitizer, run one level deeper so its cells stay separate.
macro sanitize_call(target, obj, iface, al, repl, empty) {
  call PROG_SANITIZE, OP_SANITIZE_LIST, target, obj, iface, al, repl, empty
  read_reply r_status
  in changed, h_out, removed, blocked
}

read_header
ifne rq_major ABI_MAJOR {
  respond ST_BAD_VERSION, 0
} else {
  switch rq_op {
    case OP_SANITIZE_LIST {
      in h, d_object, d_interface, d_arraylist, allow_replacement, allow_emptying
      sanitize_list
      respond ST_OK, 10
      out changed, h_out, removed, blocked
    }
    case OP_BOUNDARY_BEFORE {
      # Every List argument, before the call: may replace, may empty.
      in argc
      clear index
      set looping 1
      ifz argc { clear looping }
      while looping {
        arg index
        if a_list {
          sanitize_call a_h, p_object, p_interface, p_arraylist, 1, 1
          if changed {
            copy a_h -> h
            subv h, h_out
            if h { set_arg index, h_out }
            clear h
            report SITE_ARG, index, removed
          }
        }
        inc index
        ifeq index 0 { clear looping }
        copy argc -> flag
        subv flag, index
        ifz flag { clear looping }
      }
      respond ST_OK, 1
      outc 0
    }
    case OP_BOUNDARY_AFTER {
      in argc, threw
      ifz threw {
        # Late insertion: arguments again, typed by their runtime class and
        # never replaced, because the caller cannot see a new list.
        clear index
        set looping 1
        ifz argc { clear looping }
        while looping {
          arg index
          if a_list {
            sanitize_call a_h, r_object, r_interface, r_arraylist, 0, 1
            if changed { report SITE_LATE_ARG, index, removed }
          }
          inc index
          copy argc -> flag
          subv flag, index
          ifz flag { clear looping }
        }
        # The returned list, then collections nested in the result.
        arg RESULT_INDEX
        if a_list {
          sanitize_call a_h, p_object, p_interface, p_arraylist, 1, 1
          if changed {
            copy a_h -> h
            subv h, h_out
            if h {
              set_arg RESULT_INDEX, h_out
              copy h_out -> a_h
            }
            clear h
            report SITE_RESULT, 0, removed
          }
        }
        if a_h {
          var nested_removed[4], failures[4]
          call PROG_NESTED, OP_NESTED_SANITIZE, a_h
          read_reply r_status
          in nested_removed, failures
          if nested_removed { report SITE_NESTED, 0, nested_removed }
          if failures { report SITE_REPLACEMENT_FAILURE, 0, failures }
        }
      }
      respond ST_OK, 1
      outc 0
    }
    default {
      respond ST_BAD_OPCODE, 0
    }
  }
}
